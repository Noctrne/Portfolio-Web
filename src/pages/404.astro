---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist.">
  <section class="wrap flex min-h-[60vh] flex-col justify-center py-[clamp(4rem,10vw,8rem)]">
    <p class="eyebrow" data-reveal>Error 404</p>
    <h1 class="mt-6 max-w-[20ch] text-h2 text-balance" data-reveal style="--reveal-delay: 70ms">
      This page went quiet.
    </h1>
    <p class="mt-6 max-w-[44ch] text-ink-soft" data-reveal style="--reveal-delay: 120ms">
      It may have moved, or it never existed. Everything else is still where it should be.
    </p>
    <a href="/" class="arrow-link mt-10" data-reveal style="--reveal-delay: 170ms">
      Back home
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M3 8h10M9 4l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </section>
</BaseLayout>
