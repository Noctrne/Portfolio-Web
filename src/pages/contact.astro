---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Ornament from '../components/Ornament.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${site.name} — engineering, photography, design, and collaborations.`}
>
  <header class="wrap relative overflow-hidden pt-[clamp(3rem,7vw,6rem)]">
    <Ornament
      variant="arcs"
      class="ornament-spin absolute -right-40 -top-24 hidden w-[30rem] text-clay opacity-40 md:block"
    />
    <Ornament
      variant="arcs"
      class="ornament-spin-reverse absolute -right-20 top-16 w-60 text-clay opacity-25 md:hidden"
    />
    <Ornament
      variant="contour"
      class="ornament-drift absolute -left-24 bottom-0 hidden w-[34rem] text-clay opacity-15 lg:block"
    />
    <Ornament
      variant="bloom"
      class="ornament-breathe absolute -right-24 top-24 hidden w-64 text-clay opacity-10 lg:block"
    />
    <Ornament
      variant="field"
      class="absolute right-8 bottom-3 hidden w-32 text-clay opacity-25 lg:block"
    />
    <Ornament
      variant="spark"
      class="ornament-twinkle absolute left-[46%] top-[7.5rem] hidden w-4 text-clay opacity-60 md:block"
    />
    <p class="eyebrow eyebrow-row" data-reveal>
      <Icon name="mail" size={12} />
      Contact
    </p>
    <h1 class="mt-6 max-w-[18ch] text-hero text-balance" data-reveal style="--reveal-delay: 80ms">
      Say hello.
    </h1>

    <p class="mt-8 max-w-[46ch] text-lede text-ink-soft text-pretty" data-reveal style="--reveal-delay: 140ms">
      For engineering work, photography, design, or a collaboration that crosses disciplines —
      email is the best way to reach me. I usually reply within two working days.
    </p>
  </header>

  <section class="wrap relative mt-[clamp(3rem,6vw,5rem)]">
    <Ornament
      variant="scribble"
      class="ornament-draw absolute right-0 top-4 hidden w-20 text-clay opacity-60 lg:block"
    />
    <Ornament
      variant="cross"
      class="ornament-float absolute right-[18%] -bottom-6 hidden w-3.5 text-clay opacity-50 md:block"
    />
    <a
      href={`mailto:${site.email}`}
      class="contact-mail-link group inline-flex items-center font-display text-[clamp(1.5rem,3vw,2.25rem)] leading-none tracking-[-0.02em]"
      data-reveal
    >
      <span class="contact-mail-icon" aria-hidden="true">
        <Icon name="mail" size={16} />
      </span>
      <span
        class="border-b border-line pb-1.5 transition-colors duration-300 group-hover:border-clay-deep group-hover:text-clay-deep">
        {site.email}
      </span>
    </a>
  </section>

  <section class="section relative mt-[clamp(2rem,4vw,3rem)] overflow-hidden border-t border-line">
    <Ornament
      variant="contour"
      class="ornament-drift absolute -left-24 bottom-0 hidden w-[30rem] text-clay opacity-10 lg:block"
    />
    <Ornament
      variant="field"
      class="absolute right-8 bottom-12 hidden w-24 text-clay opacity-20 xl:block"
    />
    <div class="wrap grid gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="eyebrow" data-reveal>Elsewhere</p>
        <ul class="mt-5 space-y-2.5" data-reveal style="--reveal-delay: 60ms">
          {
            site.socials.map((social) => (
              <li>
                <a href={social.href} target="_blank" rel="noreferrer" class="link social-link text-sm">
                  {social.label}
                  <Icon name="arrow-up-right" size={11} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-5 md:col-start-6">
        <p class="eyebrow" data-reveal>Helpful to include</p>
        <ul class="mt-5 space-y-3 text-sm text-ink-soft" data-reveal style="--reveal-delay: 60ms">
          <li class="flex items-baseline gap-3 border-t border-line pt-3">
            <span class="text-[0.65rem] tracking-[0.18em] text-muted">01</span>
            <span>What you're making, and where it stands</span>
          </li>
          <li class="flex items-baseline gap-3 border-t border-line pt-3">
            <span class="text-[0.65rem] tracking-[0.18em] text-muted">02</span>
            <span>Timeline and how you'd like to work together</span>
          </li>
          <li class="flex items-baseline gap-3 border-t border-line pt-3">
            <span class="text-[0.65rem] tracking-[0.18em] text-muted">03</span>
            <span>Scope — engineering, visuals, or both</span>
          </li>
          <li class="flex items-baseline gap-3 border-t border-line pt-3">
            <span class="text-[0.65rem] tracking-[0.18em] text-muted">04</span>
            <span>Links to your team or existing work</span>
          </li>
        </ul>
      </div>

      <div class="md:col-span-3 md:col-start-11 md:text-right">
        <p class="eyebrow" data-reveal>Base</p>
        <p class="mt-5 text-sm text-ink-soft" data-reveal style="--reveal-delay: 60ms">
          {site.location}<br />
          Open to remote and on-site work.
        </p>
        <p class="mt-6 text-xs text-muted" data-reveal style="--reveal-delay: 90ms">
          Currently {site.availability.toLowerCase()}.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
