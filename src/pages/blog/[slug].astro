---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Ornament from '../../components/Ornament.astro';
import portrait from '../../assets/portrait.jpg';
import { site } from '../../data/site';
import { byNewest, formatDate, readingTime } from '../../lib/blog';

type Props = { entry: CollectionEntry<'blog'> };

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);

  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, updated, tags } = entry.data;

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort(byNewest);
const currentIndex = posts.findIndex((post) => post.id === entry.id);
const next = posts[(currentIndex + 1) % posts.length];
const minutes = readingTime(entry.body);
---

<BaseLayout title={title} description={description} ogType="article">
  <article>
    <header class="wrap relative overflow-hidden pt-[clamp(2.5rem,5vw,4.5rem)]">
      <Ornament
        variant="arcs"
        class="ornament-spin absolute -right-40 -top-24 hidden w-[28rem] text-clay opacity-35 md:block"
      />
      <Ornament
        variant="arcs"
        class="ornament-spin-reverse absolute -right-20 top-16 w-56 text-clay opacity-25 md:hidden"
      />
      <Ornament
        variant="field"
        class="absolute right-8 bottom-3 hidden w-28 text-clay opacity-20 lg:block"
      />

      <a href="/blog" class="arrow-link text-muted">
        <Icon name="arrow-left" size={14} />
        All notes
      </a>

      <div class="mt-10 grid gap-8 md:grid-cols-12">
        <div class="md:col-span-8">
          <p class="eyebrow eyebrow-row" data-reveal>
            <Icon name="calendar" size={12} />
            <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
            <span class="text-line" aria-hidden="true">/</span>
            {minutes} min read
          </p>

          <h1 class="mt-6 max-w-[24ch] text-hero text-balance" data-reveal style="--reveal-delay: 80ms">
            {title}
          </h1>

          <p
            class="mt-6 max-w-[52ch] text-lede text-ink-soft text-pretty"
            data-reveal
            style="--reveal-delay: 140ms"
          >
            {description}
          </p>

          {
            tags.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2" data-reveal style="--reveal-delay: 190ms">
                {tags.map((tag) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>
            )
          }
        </div>
      </div>
    </header>

    <section class="wrap section">
      <div class="grid gap-12 md:grid-cols-12">
        <aside class="order-2 md:order-1 md:col-span-3" data-reveal>
          <div class="border-t border-line pt-5">
            <p class="eyebrow">Written by</p>
            <div class="mt-4 flex items-center gap-3">
              <Image
                src={portrait}
                alt={`Portrait of ${site.name}`}
                widths={[96, 144]}
                sizes="48px"
                loading="lazy"
                decoding="async"
                class="h-12 w-12 shrink-0 rounded-full object-cover"
              />
              <div>
                <p class="font-display text-lg leading-tight">{site.name}</p>
                <p class="mt-0.5 text-xs text-muted">{site.role}</p>
              </div>
            </div>
          </div>

          <dl class="mt-8 grid gap-5 border-t border-line pt-5 text-sm">
            <div>
              <dt class="eyebrow">Published</dt>
              <dd class="mt-2 text-ink-soft">
                <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
              </dd>
            </div>
            {
              updated && (
                <div>
                  <dt class="eyebrow">Updated</dt>
                  <dd class="mt-2 text-ink-soft">
                    <time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated)}</time>
                  </dd>
                </div>
              )
            }
            <div>
              <dt class="eyebrow">Reading time</dt>
              <dd class="mt-2 text-ink-soft">{minutes} minutes</dd>
            </div>
            {
              tags.length > 0 && (
                <div>
                  <dt class="eyebrow">Tags</dt>
                  <dd class="mt-3 flex flex-wrap gap-2">
                    {tags.map((tag) => (
                      <span class="tag">#{tag}</span>
                    ))}
                  </dd>
                </div>
              )
            }
          </dl>

          <Ornament variant="ticks" class="mt-8 h-3 w-full text-clay opacity-40" />
        </aside>

        <div class="editorial-prose blog-prose order-1 md:order-2 md:col-span-7 md:col-start-5">
          <Content />
        </div>
      </div>
    </section>

    {
      posts.length > 1 && (
        <div class="wrap">
          <a
            href={`/blog/${next.id}/`}
            class="next-link group flex items-center justify-between gap-6 border-t border-line py-8 md:py-10"
          >
            <div>
              <p class="eyebrow">Next note</p>
              <p class="mt-2 font-display text-[clamp(1.5rem,3vw,2.25rem)] leading-tight tracking-[-0.02em] transition-colors duration-300 group-hover:text-clay-deep">
                {next.data.title}
              </p>
            </div>
            <span class="next-link-circle shrink-0" aria-hidden="true">
              <Icon name="arrow-right" size={16} />
            </span>
          </a>
        </div>
      )
    }
  </article>
</BaseLayout>
