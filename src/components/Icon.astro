---
interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 18, strokeWidth = 1.3, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'arrow-left' && <path d="M20 12H5M11 6l-6 6 6 6" />}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
    </>
  )}
  {name === 'camera' && (
    <>
      <path d="M3 8.5h4L8.7 6h6.6L17 8.5h4V19H3z" />
      <circle cx="12" cy="13.5" r="3.4" />
    </>
  )}
  {name === 'code' && <path d="m8 7-5 5 5 5M16 7l5 5-5 5" />}
  {name === 'chip' && (
    <>
      <rect x="7" y="7" width="10" height="10" rx="2" />
      <path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4" />
    </>
  )}
  {name === 'pen' && (
    <>
      <path d="m4 20 4-1L19 8l-3-3L5 16z" />
      <path d="m14 7 3 3" />
    </>
  )}
  {name === 'play' && <path d="M9 6.5 18 12l-9 5.5z" />}
  {name === 'orbit' && (
    <>
      <circle cx="12" cy="12" r="8" />
      <circle cx="12" cy="12" r="2.1" />
      <path d="M12 1.8v3.4M12 18.8v3.4M1.8 12h3.4M18.8 12h3.4" />
    </>
  )}
  {name === 'asterisk' && <path d="M12 3v18M4.2 7.5l15.6 9M19.8 7.5 4.2 16.5" />}
  {name === 'sparkle' && (
    <path d="M12 3c.6 5 2.4 6.8 7.4 7.4-5 .6-6.8 2.4-7.4 7.4-.6-5-2.4-6.8-7.4-7.4C9.6 9.8 11.4 8 12 3Z" />
  )}
  {name === 'layers' && (
    <>
      <path d="m12 3 9 5-9 5-9-5z" />
      <path d="m3 12 9 5 9-5" />
      <path d="m3 16 9 5 9-5" />
    </>
  )}
  {name === 'calendar' && (
    <>
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M3 9h18M8 3v4M16 3v4" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8" />
      <path d="M12 8v4l2.6 1.6" />
    </>
  )}
  {name === 'sliders' && (
    <>
      <path d="M4 7h16M4 12h16M4 17h16" />
      <circle cx="9" cy="7" r="2" />
      <circle cx="15" cy="12" r="2" />
      <circle cx="8" cy="17" r="2" />
    </>
  )}
  {name === 'link' && (
    <>
      <path d="M10.5 13.5a4 4 0 0 0 5.7 0l2.3-2.3a4 4 0 0 0-5.7-5.7L11.5 6.8" />
      <path d="M13.5 10.5a4 4 0 0 0-5.7 0l-2.3 2.3a4 4 0 0 0 5.7 5.7l1.3-1.3" />
    </>
  )}
  {name === 'user' && (
    <>
      <circle cx="12" cy="8" r="3.5" />
      <path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6" />
    </>
  )}
  {name === 'book' && (
    <>
      <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z" />
      <path d="M4 5.5v15" />
    </>
  )}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
</svg>
