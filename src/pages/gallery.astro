---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryPlate from '../components/GalleryPlate.astro';
import Icon from '../components/Icon.astro';
import { chapters, plates, plateCount, type PlateKey } from '../data/gallery';
import { site } from '../data/site';

const pad = (value: number) => String(value).padStart(2, '0');

const sequence = chapters.flatMap((chapter) =>
  chapter.layout === 'hero-rows'
    ? [chapter.hero, ...(chapter.rows ?? []).flat()]
    : [chapter.lead, ...(chapter.stack ?? [])],
) as PlateKey[];

const numbers = new Map<PlateKey, string>(
  sequence.map((key, index) => [key, pad(index + 1)] as [PlateKey, string]),
);

const chapterCount = (chapter: (typeof chapters)[number]) =>
  chapter.layout === 'hero-rows'
    ? 1 + (chapter.rows ?? []).reduce((total, row) => total + row.length, 0)
    : 1 + (chapter.stack?.length ?? 0);
---

<BaseLayout
  title="Gallery"
  description={`Photographs by ${site.name} — mornings, small company, cities, and the dark.`}
>
  <header class="gallery-intro wrap">
    <p class="eyebrow eyebrow-row" data-reveal>
      <Icon name="camera" size={12} />
      Gallery — {pad(plateCount)} frames · 2022–2026
    </p>

    <div class="mt-6 grid gap-8 md:grid-cols-12 md:items-end">
      <h1 class="text-hero md:col-span-7" data-reveal style="--reveal-delay: 80ms">Gallery</h1>
      <p
        class="max-w-[44ch] text-lede text-ink-soft text-pretty md:col-span-5"
        data-reveal
        style="--reveal-delay: 150ms"
      >
        Photographs made away from the workbench: slow mornings, small company, the city at a
        distance, and whatever the dark was doing.
      </p>
    </div>
  </header>

  {
    chapters.map((chapter) => (
      <section class:list={['gallery-chapter', `gallery-chapter--${chapter.layout}`]}>
        <div class="chapter-head">
          <p class="chapter-label">
            <span class="chapter-number">{chapter.number}</span>
            {chapter.label}
          </p>
          <p class="chapter-count">{pad(chapterCount(chapter))} frames</p>
        </div>

        {chapter.layout === 'hero-rows' && chapter.hero && (
          <>
            <GalleryPlate
              plate={plates[chapter.hero]}
              variant="hero"
              number={numbers.get(chapter.hero) ?? '01'}
              eager={chapter.number === '01'}
            />

            {(chapter.rows ?? []).map((row) => (
              <div class:list={['gallery-row', row.length === 2 ? 'gallery-row--two' : 'gallery-row--three']}>
                {row.map((key, index) => (
                  <GalleryPlate
                    plate={plates[key]}
                    variant="thumb"
                    number={numbers.get(key) ?? pad(index + 1)}
                    delay={Math.min(index, 3) * 60}
                  />
                ))}
              </div>
            ))}
          </>
        )}

        {chapter.layout === 'split' && chapter.lead && (
          <div class="gallery-split">
            <GalleryPlate
              plate={plates[chapter.lead]}
              variant="lead"
              number={numbers.get(chapter.lead) ?? '01'}
              delay={0}
            />

            <div class="gallery-stack">
              {(chapter.stack ?? []).map((key, index) => (
                <GalleryPlate
                  plate={plates[key]}
                  variant="stack"
                  number={numbers.get(key) ?? pad(index + 2)}
                  delay={Math.min(index, 3) * 60}
                />
              ))}
            </div>
          </div>
        )}
      </section>
    ))
  }

  <section class="wrap gallery-end">
    <p class="max-w-[54ch] text-xs leading-relaxed text-muted">
      All photographs © {site.name}, {new Date().getFullYear()}. Please ask before reproducing.
    </p>

    <a href={`mailto:${site.email}`} class="arrow-link text-sm">
      Request a print
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M3 8h10M9 4l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
  </section>

  <dialog class="gallery-lightbox" data-gallery-lightbox aria-labelledby="gallery-lightbox-title">
    <div class="gallery-lightbox-frame">
      <div class="gallery-lightbox-top">
        <p class="gallery-lightbox-counter" data-lb-counter></p>
        <button type="button" class="gallery-lightbox-close" data-lb-close aria-label="Close viewer">
          <span>Close</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M4 4l8 8M12 4l-8 8"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>

      <div class="gallery-lightbox-body">
        <div class="gallery-lightbox-media" data-lb-media></div>

        <aside class="gallery-lightbox-meta">
          <p class="eyebrow" data-lb-medium></p>
          <h2 id="gallery-lightbox-title" class="gallery-lightbox-title mt-3" data-lb-title></h2>
          <p class="gallery-lightbox-year mt-2" data-lb-year></p>
          <p class="gallery-lightbox-desc mt-5" data-lb-description></p>

          <div class="gallery-lightbox-nav">
            <button type="button" data-lb-prev>← Previous</button>
            <button type="button" data-lb-next>Next →</button>
          </div>
        </aside>
      </div>
    </div>
  </dialog>
</BaseLayout>
