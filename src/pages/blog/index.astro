---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Ornament from '../../components/Ornament.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
import { byNewest, formatDate, readingTime } from '../../lib/blog';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort(byNewest);

const pad = (value: number) => String(value).padStart(2, '0');
---

<BaseLayout
  title="Blog"
  description={`Notes and essays by ${site.name} — engineering, photography, teaching, and the work between.`}
>
  <header class="wrap relative overflow-hidden pt-[clamp(3rem,7vw,6rem)] pb-[clamp(2.5rem,5vw,4rem)]">
    <Ornament
      variant="arcs"
      class="ornament-spin absolute -right-40 -top-24 hidden w-[30rem] text-clay opacity-40 md:block"
    />
    <Ornament
      variant="arcs"
      class="ornament-spin-reverse absolute -right-20 top-16 w-60 text-clay opacity-25 md:hidden"
    />
    <Ornament
      variant="contour"
      class="ornament-drift absolute -left-24 bottom-0 hidden w-[34rem] text-clay opacity-15 lg:block"
    />
    <Ornament
      variant="measure"
      class="absolute right-10 bottom-2 hidden w-[26rem] text-clay opacity-25 xl:block"
    />
    <Ornament
      variant="field"
      class="absolute right-8 bottom-3 hidden w-32 text-clay opacity-25 lg:block"
    />
    <Ornament
      variant="cross"
      class="ornament-float absolute left-[46%] top-[7.75rem] hidden w-4 text-clay opacity-50 md:block"
    />
    <p class="eyebrow eyebrow-row" data-reveal>
      <Icon name="book" size={12} />
      Journal — {pad(posts.length)} entries
    </p>

    <div class="mt-6 grid gap-8 md:grid-cols-12 md:items-end">
      <h1 class="text-hero md:col-span-7" data-reveal style="--reveal-delay: 80ms">Blog</h1>
      <p
        class="max-w-[46ch] text-lede text-ink-soft text-pretty md:col-span-5"
        data-reveal
        style="--reveal-delay: 150ms"
      >
        Notes on building things, looking closely, and teaching what I learn. Longer thoughts,
        kept here instead of in a drawer.
      </p>
    </div>
  </header>

  <section class="wrap relative overflow-hidden pb-[clamp(5rem,10vw,9rem)]">
    <Ornament
      variant="contour"
      class="ornament-drift absolute -left-24 bottom-0 hidden w-[30rem] text-clay opacity-10 lg:block"
    />
    <Ornament
      variant="field"
      class="absolute right-6 bottom-8 hidden w-24 text-clay opacity-15 xl:block"
    />
    <div
      class="flex flex-wrap items-center justify-between gap-4 border-y border-line py-4"
      data-reveal
    >
      <p class="eyebrow eyebrow-row">
        <Icon name="asterisk" size={12} />
        Latest first
      </p>
      <p class="text-xs text-muted">
        <span class="tabular-nums">{pad(posts.length)}</span> entries · essays &amp; field notes
      </p>
    </div>

    {
      posts.length > 0 ? (
        <ul>
          {posts.map((post, index) => (
            <li
              class="border-b border-line"
              data-reveal
              style={`--reveal-delay: ${Math.min(index, 4) * 60}ms`}
            >
              <a
                href={`/blog/${post.id}/`}
                class="next-link index-row group grid gap-4 py-8 md:grid-cols-12 md:items-baseline"
              >
                <span class="flex items-center gap-3 text-xs tabular-nums text-muted md:col-span-3 lg:col-span-2">
                  <span class="text-[0.65rem] tracking-[0.18em]">{pad(index + 1)}</span>
                  <time class="whitespace-nowrap" datetime={post.data.date.toISOString().slice(0, 10)}>
                    {formatDate(post.data.date)}
                  </time>
                </span>

                <span class="block md:col-span-6 lg:col-span-7">
                  <span class="block font-display text-[clamp(1.45rem,2.6vw,2rem)] leading-tight tracking-[-0.02em] transition-colors duration-300 group-hover:text-clay-deep">
                    {post.data.title}
                  </span>
                  <span class="mt-2 block max-w-[58ch] text-sm leading-relaxed text-ink-soft">
                    {post.data.description}
                  </span>
                  {
                    post.data.tags.length > 0 && (
                      <span class="mt-4 flex flex-wrap gap-2">
                        {post.data.tags.map((tag) => (
                          <span class="tag">#{tag}</span>
                        ))}
                      </span>
                    )
                  }
                </span>

                <span class="flex items-center justify-between gap-4 md:col-span-3 md:justify-end">
                  <span class="flex items-center gap-1.5 text-xs text-muted">
                    <Icon name="clock" size={12} />
                    {readingTime(post.body)} min read
                  </span>
                  <span class="next-link-circle" aria-hidden="true">
                    <Icon name="arrow-right" size={15} />
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="border-b border-line py-10 text-sm text-ink-soft">
          The first note is still being written. Check back soon.
        </p>
      )
    }
  </section>
</BaseLayout>
