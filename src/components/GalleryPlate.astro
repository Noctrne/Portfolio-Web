---
import { Image } from 'astro:assets';
import type { Plate } from '../data/gallery';

interface Props {
  plate: Plate;
  variant: 'hero' | 'thumb' | 'lead' | 'stack';
  number: string;
  delay?: number;
  eager?: boolean;
}

const { plate, variant, number, delay = 0, eager = false } = Astro.props;

const { src, title, caption, year, alt, description } = plate;

const words = title.split(' ');
const splitAt = Math.ceil(words.length / 2);
const lines =
  words.length > 1 ? [words.slice(0, splitAt).join(' '), words.slice(splitAt).join(' ')] : [title];

const widths =
  variant === 'hero'
    ? [800, 1200, 1600, 2000]
    : variant === 'lead'
      ? [600, 900, 1200, 1600]
      : [480, 720, 960];

const sizes =
  variant === 'hero'
    ? '100vw'
    : variant === 'lead'
      ? '(min-width: 1024px) 56vw, 100vw'
      : variant === 'stack'
        ? '(min-width: 1024px) 32vw, 100vw'
        : '(min-width: 768px) 33vw, 100vw';
---

<figure
  class:list={['plate', `plate--${variant}`]}
  data-tilt
  data-reveal
  style={`--reveal-delay: ${delay}ms`}
>
  <button
    type="button"
    class="plate-button"
    data-gallery-item
    data-title={title}
    data-medium="Photography"
    data-year={year}
    data-description={description}
    data-src={src.src}
    data-alt={alt}
    data-plate={number}
    aria-label={`Open ${title} — photograph, ${year}`}
  >
    <span class="plate-frame">
      <Image
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="plate-img"
      />

      {
        (variant === 'hero' || variant === 'lead') && (
          <span class="plate-caption" aria-hidden="true">
            <span class="plate-caption-title">
              {lines.map((line) => (
                <span class="plate-caption-line">{line}</span>
              ))}
            </span>
            <span class="plate-caption-meta">{caption}</span>
          </span>
        )
      }
    </span>
  </button>

  {
    variant !== 'hero' && (
      <figcaption class="plate-foot">
        <span class="plate-foot-number">{number}</span>
        <span class="plate-foot-title">{title}</span>
        <span class="plate-foot-year">{year}</span>
      </figcaption>
    )
  }
</figure>
