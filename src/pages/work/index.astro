---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import Icon from '../../components/Icon.astro';
import Ornament from '../../components/Ornament.astro';
import { getCollection } from 'astro:content';

const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const categories = [
  { value: 'all', label: 'All', count: works.length },
  { value: 'autonomy', label: 'Autonomy', count: works.filter((w) => w.data.category === 'autonomy').length },
  { value: 'software', label: 'Software', count: works.filter((w) => w.data.category === 'software').length },
  { value: 'embedded', label: 'Embedded', count: works.filter((w) => w.data.category === 'embedded').length },
  { value: 'design', label: 'Design', count: works.filter((w) => w.data.category === 'design').length },
];

const categoryIcons: Record<string, string> = {
  all: 'asterisk',
  autonomy: 'orbit',
  software: 'code',
  embedded: 'chip',
  design: 'pen',
};

const pad = (value: number) => String(value).padStart(2, '0');
---

<BaseLayout
  title="Work"
  description="Selected engineering projects across autonomy, computer vision, and embedded systems."
>
  <header class="wrap relative overflow-hidden pt-[clamp(3rem,7vw,6rem)] pb-[clamp(2rem,4vw,3rem)]">
    <Ornament
      variant="arcs"
      class="ornament-spin absolute -right-40 -top-24 hidden w-[30rem] text-clay opacity-40 md:block"
    />
    <Ornament
      variant="arcs"
      class="ornament-spin-reverse absolute -right-20 top-16 w-60 text-clay opacity-25 md:hidden"
    />
    <Ornament
      variant="contour"
      class="ornament-drift absolute -left-24 bottom-0 hidden w-[34rem] text-clay opacity-15 lg:block"
    />
    <Ornament
      variant="bloom"
      class="ornament-breathe absolute -right-20 top-20 hidden w-64 text-clay opacity-10 lg:block"
    />
    <Ornament
      variant="field"
      class="absolute right-8 bottom-4 hidden w-32 text-clay opacity-25 lg:block"
    />
    <Ornament
      variant="spark"
      class="ornament-twinkle absolute right-[18%] bottom-12 hidden w-4 text-clay opacity-60 md:block"
    />
    <p class="eyebrow eyebrow-row" data-reveal>
      <Icon name="layers" size={12} />
      Index — {pad(works.length)} projects
    </p>
    <h1 class="mt-6 text-hero" data-reveal style="--reveal-delay: 80ms">Work</h1>

    <div class="mt-8 grid gap-8 md:grid-cols-12" data-reveal style="--reveal-delay: 150ms">
      <p class="max-w-[46ch] text-lede text-ink-soft text-pretty md:col-span-6 md:col-start-6">
        Selected work across autonomous systems, computer vision, and embedded software — each
        one documented from first constraint to final detail.
      </p>
    </div>
  </header>

  <section class="wrap pb-[clamp(5rem,10vw,9rem)]">
    <div class="flex flex-wrap items-center justify-between gap-4 border-y border-line py-4" data-reveal>
      <div class="flex flex-wrap gap-1" role="group" aria-label="Filter work by discipline">
        {
          categories.map((category) => (
            <button
              type="button"
              class:list={['filter-btn', { 'is-active': category.value === 'all' }]}
              data-filter={category.value}
              aria-pressed={category.value === 'all' ? 'true' : 'false'}
            >
              <Icon name={categoryIcons[category.value]} size={12} class="self-center" />
              {category.label}
              <span class="text-[0.7rem] tabular-nums text-muted">{pad(category.count)}</span>
            </button>
          ))
        }
      </div>

      <p class="hidden text-xs text-muted sm:block">
        <span data-work-count class="tabular-nums">{pad(works.length)}</span> shown
      </p>
    </div>

    <div class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-10">
      {
        works.map((entry, index) => (
          <WorkCard
            entry={entry}
            index={index + 1}
            delay={Math.min(index, 5) * 60}
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
