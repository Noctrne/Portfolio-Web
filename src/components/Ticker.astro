---
import Ornament from './Ornament.astro';

interface Props {
  items?: string[];
  class?: string;
}

const {
  items = ['Autonomy', 'Photography', 'Design', 'Teaching', 'Systems', 'Image-making'],
  class: className,
} = Astro.props;
---

<div class:list={['ticker', className]} aria-hidden="true">
  <div class="ticker-track">
    {
      [0, 1, 2, 3, 4, 5].map(() => (
        <div class="ticker-group">
          {items.map((item) => (
            <span class="ticker-item">
              <Ornament variant="spark" class="ticker-spark" />
              {item}
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>
