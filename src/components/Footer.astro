---
import { site } from '../data/site';
import Icon from './Icon.astro';
import Ornament from './Ornament.astro';
---

<footer class="relative overflow-hidden border-t border-line">
  <Ornament
    variant="orbit"
    class="ornament-spin absolute -right-16 -bottom-24 w-72 text-clay opacity-20"
  />
  <Ornament
    variant="cross"
    class="ornament-float absolute left-8 top-8 hidden w-3.5 text-clay opacity-45 md:block"
  />
  <div class="wrap relative z-10 grid gap-12 py-14 md:grid-cols-12 md:py-16">
    <div class="md:col-span-5">
      <p class="font-display text-2xl tracking-[-0.02em]">{site.name}</p>
      <p class="mt-2 max-w-[30ch] text-sm text-muted">{site.role}</p>
    </div>

    <div class="md:col-span-3">
      <p class="eyebrow">Elsewhere</p>
      <ul class="mt-4 space-y-2">
        {
          site.socials.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noreferrer" class="link social-link text-sm">
                {social.label}
                <Icon name="arrow-up-right" size={12} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="md:col-span-4 md:text-right">
      <p class="eyebrow">Contact</p>
      <a href={`mailto:${site.email}`} class="link social-link mt-4 inline-flex text-sm">
        <Icon name="mail" size={13} />
        {site.email}
      </a>
      <p class="mt-8 text-xs text-muted">© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
