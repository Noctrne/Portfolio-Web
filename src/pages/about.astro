---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import portrait from '../assets/portrait.jpg';
import { capabilities, education, experience, recognition, site } from '../data/site';
---

<BaseLayout
  title="About"
  description={`About ${site.name} — engineer, photographer, and designer based in ${site.location}.`}
>
  <header class="wrap pt-[clamp(3rem,7vw,6rem)] pb-[clamp(2.5rem,5vw,4rem)]">
    <p class="eyebrow" data-reveal>About</p>
    <h1 class="mt-6 max-w-[22ch] text-hero text-balance" data-reveal style="--reveal-delay: 80ms">
      An engineer by training, a photographer by habit.
    </h1>
  </header>

  <section class="wrap pb-[clamp(4rem,8vw,7rem)]">
    <div class="grid gap-10 md:grid-cols-12 lg:gap-16">
      <div class="md:col-span-5" data-reveal="pop">
        <div class="aspect-[4/5] overflow-hidden bg-paper-deep">
          <Image
            src={portrait}
            alt={`Portrait of ${site.name}`}
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 768px) 38vw, 100vw"
            loading="eager"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
        <p class="mt-3 text-xs text-muted">Portrait — replace with your own photograph.</p>
      </div>

      <div class="md:col-span-6 md:col-start-7">
        <p class="text-lede text-ink-soft text-pretty" data-reveal>
          I'm an Electronics and Instrumentation student at Universitas Gadjah Mada. Outside the lab
          I photograph and design. Most of my engineering work is on autonomous systems: perception,
          control, and the software that holds a robot together.
        </p>

        <div class="mt-8 space-y-5 text-[0.95rem] leading-relaxed text-ink-soft" data-reveal style="--reveal-delay: 60ms">
          <p>
            I lead the ORCA V3 sub-team at Gadjah Mada Robotic Team, where we took an autonomous
            underwater vehicle to the Top 8 worldwide at SAUVC 2026. Before that I was a programmer
            on the same team; now I also mentor programmers as senior programmer in Elins Research
            Club's robotics division.
          </p>
          <p>
            Alongside engineering I photograph, design, and teach. Those habits keep my technical
            work clearer and more human — a system is finished when someone else can understand it,
            not just when it runs.
          </p>
        </div>

        <dl class="mt-10 grid gap-6 border-t border-line pt-6 sm:grid-cols-2" data-reveal style="--reveal-delay: 120ms">
          <div>
            <dt class="eyebrow">Based in</dt>
            <dd class="mt-2 text-sm text-ink-soft">{site.location}</dd>
          </div>
          <div>
            <dt class="eyebrow">Focus</dt>
            <dd class="mt-2 text-sm text-ink-soft">Engineering · Photography · Design</dd>
          </div>
          <div>
            <dt class="eyebrow">Tools</dt>
            <dd class="mt-2 text-sm text-ink-soft">C++ · Python · ROS2 · Linux · Fusion 360</dd>
          </div>
          <div>
            <dt class="eyebrow">Availability</dt>
            <dd class="mt-2 text-sm text-ink-soft">{site.availability}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section border-t border-line">
    <div class="wrap grid gap-10 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="eyebrow" data-reveal>Capabilities</p>
      </div>

      <div class="grid gap-10 sm:grid-cols-3 md:col-span-9">
        {
          capabilities.map((group, index) => (
            <div class="border-t border-line pt-5" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <h2 class="text-h3">{group.title}</h2>
              <ul class="mt-4 space-y-1.5 text-sm text-muted">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section border-t border-line">
    <div class="wrap grid gap-10 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="eyebrow" data-reveal>Experience</p>
      </div>

      <ul class="md:col-span-8 md:col-start-5">
        {
          experience.map((item, index) => (
            <li
              class="grid gap-2 border-t border-line py-6 sm:grid-cols-[7rem_1fr] sm:gap-6"
              data-reveal
              style={`--reveal-delay: ${Math.min(index, 4) * 50}ms`}
            >
              <span class="text-sm tabular-nums text-muted">{item.period}</span>
              <div>
                <p class="font-display text-lg leading-snug">{item.title}</p>
                <p class="mt-1 text-sm text-muted">{item.org}</p>
                <p class="mt-2 max-w-[48ch] text-sm leading-relaxed text-ink-soft">{item.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section border-t border-line">
    <div class="wrap grid gap-10 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="eyebrow" data-reveal>Education</p>
      </div>

      <div class="md:col-span-8 md:col-start-5">
        <ul>
          {
            education.map((item, index) => (
              <li
                class="grid gap-2 border-t border-line py-6 sm:grid-cols-[7rem_1fr] sm:gap-6"
                data-reveal
                style={`--reveal-delay: ${index * 60}ms`}
              >
                <span class="text-sm tabular-nums text-muted">{item.period}</span>
                <div>
                  <p class="font-display text-lg leading-snug">{item.title}</p>
                  <p class="mt-1 text-sm text-muted">{item.note}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <ul class="mt-10 space-y-3">
          {
            recognition.map((item, index) => (
              <li
                class="border-t border-line pt-3 text-sm text-ink-soft"
                data-reveal
                style={`--reveal-delay: ${index * 40}ms`}
              >
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
