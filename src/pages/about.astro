---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import portrait from '../assets/portrait.jpg';
import { capabilities, site } from '../data/site';

const timeline = [
  { year: '2026', title: 'Independent practice', note: 'Photography, design, and web work for small studios.' },
  { year: '2024', title: 'Design systems & product interfaces', note: 'Long-form reading tools and editorial platforms.' },
  { year: '2022', title: 'Freelance photography', note: 'Editorial, portrait, and still life commissions.' },
  { year: '2019', title: 'First commissioned work', note: 'Where the archive begins.' },
];
---

<BaseLayout
  title="About"
  description={`About ${site.name} — photographer, designer, and developer based in ${site.location}.`}
>
  <header class="wrap pt-[clamp(3rem,7vw,6rem)] pb-[clamp(2.5rem,5vw,4rem)]">
    <p class="eyebrow" data-reveal>About</p>
    <h1 class="mt-6 max-w-[22ch] text-hero text-balance" data-reveal style="--reveal-delay: 80ms">
      A photographer who learned to build.
    </h1>
  </header>

  <section class="wrap pb-[clamp(4rem,8vw,7rem)]">
    <div class="grid gap-10 md:grid-cols-12 lg:gap-16">
      <div class="md:col-span-5" data-reveal="pop">
        <div class="aspect-[4/5] overflow-hidden bg-paper-deep">
          <Image
            src={portrait}
            alt={`Portrait of ${site.name}`}
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 768px) 38vw, 100vw"
            loading="eager"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
        <p class="mt-3 text-xs text-muted">Portrait — replace with your own photograph.</p>
      </div>

      <div class="md:col-span-6 md:col-start-7">
        <p class="text-lede text-ink-soft text-pretty" data-reveal>
          I work across three disciplines that keep teaching each other things: photography trains
          the eye, design trains the decision, and code keeps both honest about what is actually
          possible.
        </p>

        <div class="mt-8 space-y-5 text-[0.95rem] leading-relaxed text-ink-soft" data-reveal style="--reveal-delay: 60ms">
          <p>
            Most of my work starts with a constraint — one window, one typeface, one page that has
            to load in under a second. Constraints make the decisions easier, and the result
            calmer.
          </p>
          <p>
            I'm based in {site.location} and work with people anywhere. I like projects with a
            long horizon: a series that takes a year, a system that will outlive its first
            redesign, a site that stays readable for a decade.
          </p>
        </div>

        <dl class="mt-10 grid gap-6 border-t border-line pt-6 sm:grid-cols-2" data-reveal style="--reveal-delay: 120ms">
          <div>
            <dt class="eyebrow">Based in</dt>
            <dd class="mt-2 text-sm text-ink-soft">{site.location}</dd>
          </div>
          <div>
            <dt class="eyebrow">Focus</dt>
            <dd class="mt-2 text-sm text-ink-soft">Photography · Editorial design · Web</dd>
          </div>
          <div>
            <dt class="eyebrow">Tools</dt>
            <dd class="mt-2 text-sm text-ink-soft">Lightroom · Figma · Astro</dd>
          </div>
          <div>
            <dt class="eyebrow">Availability</dt>
            <dd class="mt-2 text-sm text-ink-soft">Open for selected projects</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section border-t border-line">
    <div class="wrap grid gap-10 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="eyebrow" data-reveal>Capabilities</p>
      </div>

      <div class="grid gap-10 sm:grid-cols-3 md:col-span-9">
        {
          capabilities.map((group, index) => (
            <div class="border-t border-line pt-5" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <h2 class="text-h3">{group.title}</h2>
              <ul class="mt-4 space-y-1.5 text-sm text-muted">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section border-t border-line">
    <div class="wrap grid gap-10 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="eyebrow" data-reveal>Path</p>
      </div>

      <ul class="md:col-span-8 md:col-start-5">
        {
          timeline.map((item, index) => (
            <li
              class="grid gap-2 border-t border-line py-6 sm:grid-cols-[6rem_1fr] sm:gap-6"
              data-reveal
              style={`--reveal-delay: ${Math.min(index, 3) * 60}ms`}
            >
              <span class="text-sm tabular-nums text-muted">{item.year}</span>
              <div>
                <p class="font-display text-lg leading-snug">{item.title}</p>
                <p class="mt-1 text-sm text-muted">{item.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
