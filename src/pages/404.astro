---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Ornament from '../components/Ornament.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist.">
  <section class="wrap relative flex min-h-[60vh] flex-col justify-center overflow-hidden py-[clamp(4rem,10vw,8rem)]">
    <Ornament
      variant="arcs"
      class="ornament-spin absolute right-6 top-[calc(50%-9rem)] hidden w-72 text-clay opacity-35 md:block"
    />
    <Ornament
      variant="arcs"
      class="ornament-spin-reverse absolute -right-20 top-12 w-56 text-clay opacity-20 md:hidden"
    />
    <Ornament
      variant="contour"
      class="ornament-drift absolute -left-24 bottom-0 hidden w-[34rem] text-clay opacity-15 lg:block"
    />
    <Ornament
      variant="spark"
      class="ornament-twinkle absolute left-[44%] top-[22%] hidden w-4 text-clay opacity-60 md:block"
    />
    <p class="eyebrow eyebrow-row" data-reveal>
      <Icon name="orbit" size={12} />
      Error 404
    </p>
    <h1 class="mt-6 max-w-[20ch] text-h2 text-balance" data-reveal style="--reveal-delay: 70ms">
      This page went quiet.
    </h1>
    <p class="mt-6 max-w-[44ch] text-ink-soft" data-reveal style="--reveal-delay: 120ms">
      It may have moved, or it never existed. Everything else is still where it should be.
    </p>
    <a href="/" class="arrow-link mt-10" data-reveal style="--reveal-delay: 170ms">
      Back home
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M3 8h10M9 4l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </section>
</BaseLayout>
