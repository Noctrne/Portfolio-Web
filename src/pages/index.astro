---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import ContactSection from '../components/ContactSection.astro';
import Icon from '../components/Icon.astro';
import Ornament from '../components/Ornament.astro';
import { getCollection } from 'astro:content';
import { capabilities, experience, site } from '../data/site';

const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const selected = works.filter((work) => work.data.featured).slice(0, 4);

const gallery = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
const art = gallery.filter((entry) => entry.data.featured).slice(0, 3);

const capabilityIcons = ['orbit', 'chip', 'pen'];
---

<BaseLayout>
  <section class="wrap relative overflow-hidden pt-[clamp(3.5rem,8vw,7rem)] pb-[clamp(3rem,6vw,5rem)]">
    <Ornament
      variant="arcs"
      class="absolute -right-40 -top-24 hidden w-[32rem] text-clay opacity-50 md:block"
    />
    <Ornament
      variant="arcs"
      class="absolute -right-16 top-28 w-64 text-clay opacity-30 md:hidden"
    />
    <div
      class="dot-grid absolute top-16 right-8 hidden h-32 w-44 md:block"
      aria-hidden="true"
    >
    </div>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2" data-reveal>
      <p class="eyebrow eyebrow-row">
        <Icon name="asterisk" size={11} />
        Personal portfolio — {site.year}
      </p>
      <span class="hidden h-px w-8 bg-line sm:block" aria-hidden="true"></span>
      <p class="eyebrow">{site.location}</p>
    </div>

    <h1
      class="mt-8 max-w-[24ch] text-hero text-balance"
      data-reveal
      style="--reveal-delay: 80ms"
    >
      An engineer, a camera, and the{' '}
      <span class="relative inline-block">
        <em class="font-light italic text-clay-deep">quiet</em>
        <Ornament variant="wave" class="curve-underline" />
      </span>{' '}
      space between.
    </h1>

    <div
      class="mt-[clamp(2.5rem,6vw,4.5rem)] grid gap-8 md:grid-cols-12"
      data-reveal
      style="--reveal-delay: 160ms"
    >
      <p
        class="text-lede text-ink-soft text-pretty md:col-span-6 md:col-start-6 lg:col-span-5 lg:col-start-8"
      >
        I'm {site.firstName} — a robotics engineer, photographer, and Electronics & Instrumentation
        student in Yogyakarta. I build autonomous vehicles and computer-vision systems; away from
        the lab I photograph, design, and teach. This site keeps both.
      </p>
    </div>

    <dl
      class="mt-[clamp(3rem,7vw,5.5rem)] grid gap-6 border-t border-line pt-6 sm:grid-cols-3"
      data-reveal
      style="--reveal-delay: 230ms"
    >
      <div>
        <dt class="eyebrow">Practice</dt>
        <dd class="mt-2 text-sm text-ink-soft">Engineering · Photography · Design</dd>
      </div>
      <div>
        <dt class="eyebrow">Based in</dt>
        <dd class="mt-2 text-sm text-ink-soft">{site.location}</dd>
      </div>
      <div>
        <dt class="eyebrow">Status</dt>
        <dd class="mt-2 text-sm text-ink-soft">{site.availability}</dd>
      </div>
    </dl>
  </section>

  <section class="section border-t border-line">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow eyebrow-row" data-reveal>
            <Icon name="asterisk" size={12} />
            Index — {String(selected.length).padStart(2, '0')} selected
          </p>
          <h2 class="mt-5 text-h2" data-reveal style="--reveal-delay: 60ms">Selected work</h2>
        </div>
        <a href="/work" class="arrow-link" data-reveal style="--reveal-delay: 120ms">
          All work
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <div class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:gap-x-12">
        {
          selected.map((entry, index) => (
            <WorkCard entry={entry} index={index + 1} delay={Math.min(index, 3) * 70} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section border-t border-line">
    <div class="wrap grid gap-10 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="eyebrow eyebrow-row" data-reveal>
          <Icon name="orbit" size={12} />
          Experience
        </p>
      </div>

      <div class="md:col-span-8 md:col-start-5">
        <ul class="timeline">
          {
            experience.slice(0, 3).map((item, index) => (
              <li
                class="timeline-item grid gap-2 border-t border-line py-6 sm:grid-cols-[7rem_1fr] sm:gap-6"
                data-reveal
                style={`--reveal-delay: ${Math.min(index, 3) * 60}ms`}
              >
                <span class="text-sm tabular-nums text-muted">{item.period}</span>
                <div>
                  <p class="font-display text-lg leading-snug">{item.title}</p>
                  <p class="mt-1 text-sm text-muted">{item.org}</p>
                  <p class="mt-2 max-w-[46ch] text-sm leading-relaxed text-ink-soft">{item.note}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <a href="/about" class="arrow-link mt-8" data-reveal style="--reveal-delay: 200ms">
          Full background
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section border-t border-line">
    <div class="wrap grid gap-10 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="eyebrow eyebrow-row" data-reveal>
          <Icon name="layers" size={12} />
          Capabilities
        </p>
      </div>

      <div class="grid gap-10 sm:grid-cols-3 md:col-span-9">
        {
          capabilities.map((group, index) => (
            <div
              class="cap-card border-t border-line pt-5"
              data-reveal
              style={`--reveal-delay: ${index * 70}ms`}
            >
              <span class="cap-icon">
                <Icon name={capabilityIcons[index]} size={18} />
              </span>
              <h3 class="text-h3">{group.title}</h3>
              <ul class="mt-4 space-y-1.5 text-sm text-muted">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section border-t border-line">
    <div class="wrap grid gap-10 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="eyebrow eyebrow-row" data-reveal>
          <Icon name="pen" size={12} />
          About
        </p>
      </div>

      <div class="relative md:col-span-7 md:col-start-5">
        <Ornament
          variant="orbit"
          class="absolute -left-24 top-2 hidden w-14 text-clay opacity-40 lg:block"
        />
        <p class="font-display text-h3 leading-snug text-balance" data-reveal>
          I care about systems that behave well when nobody is watching — a vehicle that finds its
          way back, a sensor reading you can trust, a page that loads before you notice.
        </p>
        <p class="mt-6 max-w-[46ch] text-sm leading-relaxed text-ink-soft" data-reveal style="--reveal-delay: 60ms">
          My practice moves between engineering and image-making. Different tools, same instinct:
          understand the constraint, remove what isn't needed, then make the rest dependable.
        </p>
        <a href="/about" class="arrow-link mt-8" data-reveal style="--reveal-delay: 120ms">
          More about me
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  {
    art.length > 0 && (
      <section class="section border-t border-line">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class="eyebrow eyebrow-row" data-reveal>
                <Icon name="camera" size={12} />
                Gallery
              </p>
              <h2 class="mt-5 text-h2" data-reveal style="--reveal-delay: 60ms">
                Outside the lab.
              </h2>
            </div>
            <a href="/gallery" class="arrow-link" data-reveal style="--reveal-delay: 120ms">
              Visit gallery
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M3 8h10M9 4l4 4-4 4"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>

          <div class="mt-10 grid grid-cols-2 items-end gap-4 sm:grid-cols-12 sm:gap-6">
            {art.map((entry, index) => (
              <a
                href="/gallery"
                class:list={[
                  'group block',
                  index === 0 ? 'sm:col-span-5' : index === 1 ? 'sm:col-span-4' : 'col-span-2 sm:col-span-3',
                ]}
                data-reveal
                style={`--reveal-delay: ${index * 80}ms`}
              >
                <span class="relative block overflow-hidden bg-paper-deep">
                  <Image
                    src={entry.data.cover}
                    alt={entry.data.coverAlt || entry.data.title}
                    widths={[480, 720, 960]}
                    sizes="(min-width: 640px) 30vw, 50vw"
                    loading="lazy"
                    decoding="async"
                    class="h-auto w-full transition-transform duration-[1200ms] ease-out-expo group-hover:scale-[1.03]"
                  />
                  <Ornament
                    variant="corners"
                    class="absolute inset-0 h-full w-full text-ink opacity-30"
                  />
                </span>
                <span class="mt-3 flex items-baseline justify-between gap-3 border-t border-line pt-2.5">
                  <span class="text-sm">{entry.data.title}</span>
                  <span class="eyebrow">{entry.data.medium}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ContactSection />
</BaseLayout>
