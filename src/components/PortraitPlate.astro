---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import portrait from '../assets/portrait.jpg';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const alt = 'Abyasa Pradhipta standing on a road between tea terraces in Wonosobo';
---

<figure class:list={['portrait-plate', className]} data-portrait>
  <div class="portrait-stage">
    <div class="portrait-card">
      <div class="portrait-print">
        <span class="portrait-outline" aria-hidden="true"></span>

        <div class="portrait-frame" data-portrait-frame>
          <Image
            src={portrait}
            alt={alt}
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 1024px) 40vw, (min-width: 640px) 55vw, 88vw"
            loading="lazy"
            decoding="async"
            class="portrait-img portrait-img--base"
          />

          <span class="portrait-halftone" aria-hidden="true"></span>

          <span class="portrait-lens" aria-hidden="true">
            <Image
              src={portrait}
              alt=""
              widths={[480, 720, 960, 1200]}
              sizes="(min-width: 1024px) 40vw, (min-width: 640px) 55vw, 88vw"
              loading="lazy"
              decoding="async"
              class="portrait-img portrait-img--color"
            />
          </span>

          <span class="portrait-ring" aria-hidden="true"></span>

          <span class="portrait-mark" aria-hidden="true">
            <span class="portrait-mark-cross"></span>
            <span class="portrait-mark-num">01</span>
          </span>
        </div>
      </div>

      <figcaption class="portrait-caption">
        <span class="eyebrow eyebrow-row">
          <Icon name="camera" size={11} />
          Portrait — 001
        </span>
        <span class="text-xs text-muted">Wonosobo, 2025</span>
      </figcaption>

      <p class="portrait-hint" aria-hidden="true">
        <span class="portrait-hint-dot"></span>
        <span class="portrait-hint-mouse">Move the cursor to develop the print</span>
        <span class="portrait-hint-touch">Touch to develop the print</span>
      </p>
    </div>
  </div>
</figure>
