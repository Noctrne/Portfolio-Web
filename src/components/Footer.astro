---
import { site } from '../data/site';
---

<footer class="border-t border-line">
  <div class="wrap grid gap-12 py-14 md:grid-cols-12 md:py-16">
    <div class="md:col-span-5">
      <p class="font-display text-2xl tracking-[-0.02em]">{site.name}</p>
      <p class="mt-2 max-w-[30ch] text-sm text-muted">{site.role}</p>
    </div>

    <div class="md:col-span-3">
      <p class="eyebrow">Elsewhere</p>
      <ul class="mt-4 space-y-2">
        {
          site.socials.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noreferrer" class="link text-sm">
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="md:col-span-4 md:text-right">
      <p class="eyebrow">Contact</p>
      <a href={`mailto:${site.email}`} class="link mt-4 inline-block text-sm">{site.email}</a>
      <p class="mt-8 text-xs text-muted">© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
