---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${site.name} for engineering roles, research, and collaborations.`}
>
  <header class="wrap pt-[clamp(3rem,7vw,6rem)]">
    <p class="eyebrow" data-reveal>Contact</p>
    <h1 class="mt-6 max-w-[18ch] text-hero text-balance" data-reveal style="--reveal-delay: 80ms">
      Say hello.
    </h1>

    <p class="mt-8 max-w-[46ch] text-lede text-ink-soft text-pretty" data-reveal style="--reveal-delay: 140ms">
      For engineering roles, research collaborations, or a project that needs someone who can work
      across software and hardware — email is the best way to reach me. I usually reply within two
      working days.
    </p>
  </header>

  <section class="tone-brass mt-[clamp(3rem,6vw,5rem)] py-10 md:py-14">
    <div class="wrap">
      <a
        href={`mailto:${site.email}`}
        class="group inline-flex items-center font-display text-[clamp(1.75rem,5vw,4rem)] leading-none tracking-[-0.03em]"
        data-reveal
      >
        <span
          class="border-b border-line pb-2 transition-colors duration-300 group-hover:border-clay-deep group-hover:text-clay-deep">
          {site.email}
        </span>
      </a>
    </div>
  </section>

  <section class="section mt-[clamp(2rem,4vw,3rem)] border-t border-line">
    <div class="wrap grid gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="eyebrow" data-reveal>Elsewhere</p>
        <ul class="mt-5 space-y-2.5" data-reveal style="--reveal-delay: 60ms">
          {
            site.socials.map((social) => (
              <li>
                <a href={social.href} target="_blank" rel="noreferrer" class="link text-sm">
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-5 md:col-start-6">
        <p class="eyebrow" data-reveal>Helpful to include</p>
        <ul class="mt-5 space-y-3 text-sm text-ink-soft" data-reveal style="--reveal-delay: 60ms">
          <li class="border-t border-line pt-3">The role, project, or problem you have in mind</li>
          <li class="border-t border-line pt-3">Timeline, location, and working arrangement</li>
          <li class="border-t border-line pt-3">Technical scope — software, hardware, or both</li>
          <li class="border-t border-line pt-3">Links to your team or existing work</li>
        </ul>
      </div>

      <div class="md:col-span-3 md:col-start-11 md:text-right">
        <p class="eyebrow" data-reveal>Base</p>
        <p class="mt-5 text-sm text-ink-soft" data-reveal style="--reveal-delay: 60ms">
          {site.location}<br />
          Open to remote and on-site work.
        </p>
        <p class="mt-6 text-xs text-muted" data-reveal style="--reveal-delay: 90ms">
          Currently {site.availability.toLowerCase()}.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
