---
interface Props {
  id: string;
  text?: string;
  class?: string;
}

const {
  id,
  text = 'ENGINEER · PHOTOGRAPHER · DESIGNER · 2026 · ',
  class: className,
} = Astro.props;
---

<svg
  class:list={['seal', className]}
  viewBox="0 0 120 120"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <path id={id} d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0" />
  </defs>

  <circle cx="60" cy="60" r="55" stroke="currentColor" stroke-width="1" opacity="0.28" />
  <g class="seal-text">
    <text
      font-family="var(--font-sans)"
      font-size="7"
      letter-spacing="1.6"
      fill="currentColor"
    >
      <textPath href={`#${id}`} startOffset="0">{text}</textPath>
    </text>
  </g>

  <g class="seal-center" stroke="currentColor" stroke-linecap="round">
    <path d="M60 47v26M47 60h26" stroke-width="1.2" opacity="0.8" />
    <circle cx="60" cy="60" r="18" stroke-width="1" opacity="0.35" />
  </g>
</svg>
