---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import ContactSection from '../components/ContactSection.astro';
import { getCollection } from 'astro:content';
import { capabilities, site } from '../data/site';

const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const selected = works.filter((work) => work.data.featured).slice(0, 4);
---

<BaseLayout>
  <section class="wrap pt-[clamp(3.5rem,8vw,7rem)] pb-[clamp(3rem,6vw,5rem)]">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2" data-reveal>
      <p class="eyebrow">Portfolio — {site.year}</p>
      <span class="hidden h-px w-8 bg-line sm:block" aria-hidden="true"></span>
      <p class="eyebrow">{site.location}</p>
    </div>

    <h1
      class="mt-8 max-w-[24ch] text-hero text-balance"
      data-reveal
      style="--reveal-delay: 80ms"
    >
      Photographs, interfaces, and the <em class="font-light italic text-clay-deep">quiet</em> space
      between.
    </h1>

    <div
      class="mt-[clamp(2.5rem,6vw,4.5rem)] grid gap-8 md:grid-cols-12"
      data-reveal
      style="--reveal-delay: 160ms"
    >
      <p
        class="text-lede text-ink-soft text-pretty md:col-span-6 md:col-start-6 lg:col-span-5 lg:col-start-8"
      >
        I'm {site.firstName} — a photographer and designer who also builds for the web. A record
        of images, identities, and interfaces made with care.
      </p>
    </div>

    <dl
      class="mt-[clamp(3rem,7vw,5.5rem)] grid gap-6 border-t border-line pt-6 sm:grid-cols-3"
      data-reveal
      style="--reveal-delay: 230ms"
    >
      <div>
        <dt class="eyebrow">Practice</dt>
        <dd class="mt-2 text-sm text-ink-soft">Photography · Design · Development</dd>
      </div>
      <div>
        <dt class="eyebrow">Based in</dt>
        <dd class="mt-2 text-sm text-ink-soft">{site.location}</dd>
      </div>
      <div>
        <dt class="eyebrow">Status</dt>
        <dd class="mt-2 text-sm text-ink-soft">Open for selected projects</dd>
      </div>
    </dl>
  </section>

  <section class="section border-t border-line">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="text-h2" data-reveal>Selected work</h2>
        <a href="/work" class="arrow-link" data-reveal style="--reveal-delay: 60ms">
          All work
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <div class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:gap-x-12">
        {
          selected.map((entry, index) => (
            <WorkCard entry={entry} delay={Math.min(index, 3) * 70} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section border-t border-line">
    <div class="wrap grid gap-10 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="eyebrow" data-reveal>Capabilities</p>
      </div>

      <div class="grid gap-10 sm:grid-cols-3 md:col-span-9">
        {
          capabilities.map((group, index) => (
            <div class="border-t border-line pt-5" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <h3 class="text-h3">{group.title}</h3>
              <ul class="mt-4 space-y-1.5 text-sm text-muted">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section border-t border-line">
    <div class="wrap grid gap-10 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="eyebrow" data-reveal>About</p>
      </div>

      <div class="md:col-span-7 md:col-start-5">
        <p class="font-display text-h3 leading-snug text-balance" data-reveal>
          I care about the parts you don't notice — the margin before a heading, the second before
          an animation settles, the weight of a photograph.
        </p>
        <p class="mt-6 max-w-[46ch] text-sm leading-relaxed text-ink-soft" data-reveal style="--reveal-delay: 60ms">
          My work moves between photography, graphic design, and front-end development. Different
          tools, same instinct: remove what isn't needed, then give the rest room to breathe.
        </p>
        <a href="/about" class="arrow-link mt-8" data-reveal style="--reveal-delay: 120ms">
          More about me
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
