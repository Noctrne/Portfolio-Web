---
interface Props {
  variant?: 'arcs' | 'orbit' | 'corners' | 'wave' | 'ticks' | 'scribble';
  class?: string;
}

const { variant = 'arcs', class: className } = Astro.props;
---

{
  variant === 'arcs' && (
    <svg
      class:list={['ornament', className]}
      viewBox="0 0 420 420"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="210" cy="210" r="200" stroke-width="1" opacity="0.55" />
      <circle cx="210" cy="210" r="151" stroke-width="1" opacity="0.32" />
      <circle cx="210" cy="210" r="102" stroke-width="1" opacity="0.2" />
      <path d="M210 10a200 200 0 0 1 200 200" stroke-width="1" opacity="0.75" />
      <circle cx="210" cy="10" r="3.5" fill="currentColor" stroke="none" />
      <path d="M10 210h34M376 210h34M210 376v34" stroke-width="1" opacity="0.45" />
    </svg>
  )
}

{
  variant === 'orbit' && (
    <svg
      class:list={['ornament', className]}
      viewBox="0 0 120 120"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="60" cy="60" r="54" stroke-width="1" opacity="0.65" />
      <circle cx="60" cy="60" r="33" stroke-width="1" opacity="0.35" />
      <circle cx="60" cy="60" r="4.5" fill="currentColor" stroke="none" />
      <path d="M60 0v13M60 107v13M0 60h13M107 60h13" stroke-width="1" opacity="0.6" />
    </svg>
  )
}

{
  variant === 'corners' && (
    <svg
      class:list={['ornament', className]}
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      fill="none"
      stroke="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M0 12V0h12M88 0h12v12M100 88v12H88M12 100H0V88"
        stroke-width="1"
        vector-effect="non-scaling-stroke"
      />
    </svg>
  )
}

{
  variant === 'wave' && (
    <svg
      class:list={['ornament', className]}
      viewBox="0 0 240 24"
      preserveAspectRatio="none"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M2 17C50 2 92 2 140 11s58 7 98-4" stroke-width="1.4" />
    </svg>
  )
}

{
  variant === 'ticks' && (
    <svg
      class:list={['ornament', className]}
      viewBox="0 0 240 16"
      preserveAspectRatio="none"
      fill="none"
      stroke="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M0 15.5h240" stroke-width="1" opacity="0.6" />
      {Array.from({ length: 13 }).map((_, index) => (
        <path
          d={`M${index * 20} 15.5V${index % 3 === 0 ? 2 : 9}`}
          stroke-width="1"
          opacity="0.6"
        />
      ))}
    </svg>
  )
}

{
  variant === 'scribble' && (
    <svg
      class:list={['ornament', className]}
      viewBox="0 0 90 70"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M4 62C16 30 42 10 80 12" stroke-width="1.3" />
      <path d="m68 5 12 7-9 11" stroke-width="1.3" />
    </svg>
  )
}
