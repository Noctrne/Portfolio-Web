---
import { site } from '../data/site';
import Icon from './Icon.astro';
import Ornament from './Ornament.astro';
---

<section class="section relative overflow-hidden border-t border-line">
  <Ornament
    variant="orbit"
    class="ornament-spin absolute -right-10 top-12 hidden w-40 text-clay opacity-25 md:block"
  />
  <Ornament
    variant="spark"
    class="ornament-twinkle absolute right-[22%] top-16 hidden w-4 text-clay opacity-55 lg:block"
  />
  <div class="wrap relative z-10">
    <p class="eyebrow eyebrow-row" data-reveal>
      <Icon name="mail" size={12} />
      Contact
    </p>
    <h2 class="mt-6 max-w-[18ch] text-h2 text-balance" data-reveal style="--reveal-delay: 60ms">
      Building something? I'd like to hear about it.
    </h2>

    <div
      class="mt-10 flex flex-wrap items-end gap-x-14 gap-y-8"
      data-reveal
      style="--reveal-delay: 120ms"
    >
      <a
        href={`mailto:${site.email}`}
        class="contact-mail-link group inline-flex items-center font-display text-[clamp(1.35rem,2.6vw,2rem)] leading-none tracking-[-0.02em]"
      >
        <span class="contact-mail-icon" aria-hidden="true">
          <Icon name="mail" size={15} />
        </span>
        <span
          class="border-b border-line pb-1 transition-colors duration-300 group-hover:border-clay-deep group-hover:text-clay-deep">
          {site.email}
        </span>
      </a>

      <ul class="flex flex-wrap gap-x-6 gap-y-2 pb-1 text-sm">
        {
          site.socials.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noreferrer" class="link">
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
